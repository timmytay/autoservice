pipeline {
    agent any

    environment {
        // Путь к вашему Django проекту внутри репозитория
        PROJECT_DIR = 'backend'
    }

    // ==========================================
    // ТРИГГЕРЫ (Автозапуск)
    // ==========================================
    triggers {
        // Запуск при получении вебхука от GitHub
        githubPush()
        // Страховка: опрос репозитория каждые 15 минут
        pollSCM('H/15 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Код склонирован из ветки ${env.BRANCH_NAME}"
            }
        }

        stage('Setup Python') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    // Создаем чистое виртуальное окружение
                    bat 'python -m venv venv'
                    echo '✅ Виртуальное окружение создано'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python -m pip install --upgrade pip'
                    // Добавлен --timeout 100 для защиты от сетевых сбоев
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 -r autoservice\\requirements.txt'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 pytest pytest-django pytest-cov'
                    echo '✅ Зависимости установлены'
                }
            }
        }

        stage('Check Django & Migrations') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python manage.py check'
                    bat 'venv\\Scripts\\activate && python manage.py makemigrations'
                    bat 'venv\\Scripts\\activate && python manage.py migrate'
                    echo '✅ Миграции применены'
                }
            }
        }

        // ==========================================
        // СТРОГИЕ ТЕСТЫ
        // ==========================================
        stage('Run Tests') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    // Запускаем pytest. Если тесты упадут - пайплайн остановится!
                    bat 'venv\\Scripts\\activate && pytest --cov=autoservice --cov-report=term'
                    echo '✅ Все тесты успешно пройдены'
                }
            }
        }

        // ==========================================
        // ДЕПЛОЙ (Запуск реального приложения только для main)
        // ==========================================
        stage('Deploy') {
            when { 
                branch 'main' 
            }
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat '''
                        @echo off
                        :: Принудительно добавляем системные пути Windows, так как Jenkins-служба их теряет
                        set PATH=%PATH%;C:\Windows\System32
                        
                        chcp 65001 > nul
                        echo "🛑 Остановка старого сервера (если запущен)..."
                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8000 ^| findstr LISTENING') do taskkill /F /PID %%a >nul 2>&1 || echo "Старый сервер не найден"
                        
                        echo "🚀 Запуск нового сервера Django на порту 8000..."
                        :: Говорим Jenkins не убивать процесс после завершения сборки
                        set BUILD_ID=dontKillMe
                        
                        :: Запускаем сервер в фоне, перенаправляя логи в файл server.log
                        start "" /B venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8000 > server.log 2>&1
                        
                        echo "⏳ Ожидание запуска (5 секунд)..."
                        timeout /t 5 >nul
                        
                        echo "=== ЛОГ СЕРВЕРА (если он упал, ошибка будет тут) ==="
                        type server.log
                    '''
                }
            }
        }
        
        // ==========================================
        // Этап "Инфо" для всех остальных веток
        // ==========================================
        stage('Info') {
            when {
                not { branch 'main' }
            }
            steps {
                echo "ℹ️ Это тестовая ветка (${env.BRANCH_NAME}). Деплой пропущен, тесты пройдены."
            }
        }
    }

    post {
        success {
            echo "🎉 Пайплайн успешно завершен для ветки ${env.BRANCH_NAME}!"
        }
        failure {
            echo "❌ Ошибка в пайплайне! Проверьте логи этапа, на котором произошел сбой."
        }
    }
}