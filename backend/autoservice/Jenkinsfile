pipeline {
    agent any

    environment {
        PROJECT_DIR = 'backend'
    }

    triggers {
        githubPush()
        pollSCM('H/15 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "✅ Код склонирован из ветки ${env.BRANCH_NAME}"
            }
        }

        stage('Setup Python') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'python -m venv venv'
                    echo '✅ Виртуальное окружение создано'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python -m pip install --upgrade pip'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 -r autoservice\\requirements.txt'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 pytest pytest-django pytest-cov'
                    echo '✅ Зависимости установлены'
                }
            }
        }

        stage('Check Django & Migrations') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python manage.py check'
                    bat 'venv\\Scripts\\activate && python manage.py makemigrations'
                    bat 'venv\\Scripts\\activate && python manage.py migrate'
                    echo '✅ Миграции применены'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && pytest --cov=autoservice --cov-report=term'
                    echo '✅ Все тесты успешно пройдены'
                }
            }
        }

        stage('Deploy') {
            when { 
                branch 'main' 
            }
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat '''
                        @echo off
                        :: Добавляем в PATH папку с PowerShell и System32
                        set PATH=%PATH%;C:\\Windows\\System32;C:\\Windows\\System32\\WindowsPowerShell\\v1.0
                        
                        chcp 65001 > nul
                        echo "🛑 Остановка старого сервера (если запущен)..."
                        for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8000 ^| findstr LISTENING') do taskkill /F /PID %%a >nul 2>&1 || echo "Старый сервер не найден"
                        
                        :: Удаляем старые логи, чтобы не путаться
                        if exist server.log del server.log
                        if exist server_err.log del server_err.log
                        
                        echo "🚀 Запуск нового сервера Django на порту 8000..."
                        
                        :: Вызываем PowerShell по полному пути, чтобы Jenkins точно его нашел
                        C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -Command "Start-Process -FilePath './venv/Scripts/python.exe' -ArgumentList 'manage.py runserver 0.0.0.0:8000' -WindowStyle Hidden -RedirectStandardOutput 'server.log' -RedirectStandardError 'server_err.log'"
                        
                        echo "⏳ Ожидание запуска (5 секунд)..."
                        ping 127.0.0.1 -n 6 > nul
                        
                        echo "=== ЛОГ СЕРВЕРА ==="
                        if exist server.log (type server.log) else (echo "Лог сервера пуст (возможно, сервер еще стартует)")
                        
                        echo "=== ОШИБКИ СЕРВЕРА (если есть) ==="
                        if exist server_err.log (type server_err.log) else (echo "Ошибок нет")
                    '''
                }
            }
        }
        
        stage('Info') {
            when {
                not { branch 'main' }
            }
            steps {
                echo "ℹ️ Это тестовая ветка (${env.BRANCH_NAME}). Деплой пропущен, тесты пройдены."
            }
        }
    }

    post {
        success {
            echo "🎉 Пайплайн успешно завершен для ветки ${env.BRANCH_NAME}!"
        }
        failure {
            echo "❌ Ошибка в пайплайне! Проверьте логи этапа, на котором произошел сбой."
        }
    }
}