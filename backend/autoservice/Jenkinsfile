pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        PROJECT_DIR      = 'backend'
        PYTHONIOENCODING  = 'utf-8'

        ENABLE_DOCKER = 'true'
        REGISTRY      = 'localhost:5000'
        IMAGE_NAME    = 'autoservice'
    }

    stages {
        stage('Checkout') {
            steps {
                echo "Код получен из ветки ${env.BRANCH_NAME}"
            }
        }

        stage('Setup Python') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'if not exist venv\\Scripts\\python.exe python -m venv venv'
                    echo 'Виртуальное окружение готово'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python -m pip install --upgrade pip'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 -r autoservice\\requirements.txt'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 pytest pytest-django pytest-cov'
                    echo 'Зависимости установлены'
                }
            }
        }

        stage('Check Django & Migrations') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python manage.py check'
                    bat 'venv\\Scripts\\activate && python manage.py makemigrations --check --dry-run'
                    bat 'venv\\Scripts\\activate && python manage.py migrate'
                    echo 'Миграции в порядке'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && pytest --cov=autoservice --cov-report=term'
                    echo 'Все тесты успешно пройдены'
                }
            }
        }

        stage('Docker Build & Push') {
            when {
                allOf {
                    expression {
                        env.ENABLE_DOCKER == 'true'
                    }
                    anyOf {
                        branch 'main'
                        branch 'develop'
                        branch 'release/*'
                        branch 'hotfix/*'
                    }
                }
            }

            steps {
                script {
                    def tag

                    if (env.BRANCH_NAME == 'main') {
                        tag = "${env.BUILD_NUMBER}"
                    } else if (env.BRANCH_NAME == 'develop') {
                        tag = "dev-${env.BUILD_NUMBER}"
                    } else {
                        def branchTag = env.BRANCH_NAME
                            .replaceAll('[^a-zA-Z0-9_.-]', '-')

                        tag = "${branchTag}-${env.BUILD_NUMBER}"
                    }

                    def repository = "${env.REGISTRY}/${env.IMAGE_NAME}"
                    def image = "${repository}:${tag}"
                    def latest = "${repository}:latest"

                    bat "docker build -t ${image} ${env.PROJECT_DIR}"

                    bat "docker push ${image}"

                    if (env.BRANCH_NAME == 'main') {
                        bat "docker tag ${image} ${latest}"
                        bat "docker push ${latest}"
                    }

                    echo "Docker-образ опубликован: ${image}"
                }
            }
        }

        stage('Deploy (prod)') {
            when {
                branch 'main'
            }

            steps {
                script {
                    deployDjango(8000)
                }

                echo 'Production развёрнут на порту 8000'
            }
        }

        stage('Deploy (staging)') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'release/*'
                    branch 'hotfix/*'
                }
            }

            steps {
                script {
                    deployDjango(8001)
                }

                echo 'Staging развёрнут на порту 8001'
            }
        }

        stage('Info') {
            steps {
                echo """
                    Ветка: ${env.BRANCH_NAME}
                    Номер сборки: ${env.BUILD_NUMBER}
                    Docker Registry: http://${env.REGISTRY}
                    Production: http://localhost:8000
                    Staging: http://localhost:8001
                """
            }
        }
    }

    post {
        success {
            echo 'Пайплайн успешно выполнен!'
        }

        failure {
            echo 'Ошибка в пайплайне. Проверьте логи.'
        }
    }
}

def deployDjango(int port) {
    dir("${env.PROJECT_DIR}") {
        withEnv([
            'JENKINS_NODE_COOKIE=dontKillMe',
            "DEPLOY_PORT=${port}"
        ]) {
            pwsh '''
                $ErrorActionPreference = "Stop"
                $port = [int]$env:DEPLOY_PORT

                $connections = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue

                foreach ($connection in $connections) {
                    $process = Get-Process -Id $connection.OwningProcess -ErrorAction SilentlyContinue

                    if ($process) {
                        if ($process.ProcessName -like "python*") {
                            Stop-Process -Id $process.Id -Force
                        } else {
                            throw "Port $port is occupied by $($process.ProcessName)"
                        }
                    }
                }

                Start-Sleep -Seconds 2

                $python = Join-Path (Get-Location).Path "venv\\Scripts\\python.exe"

                if (-not (Test-Path $python)) {
                    throw "Python executable not found: $python"
                }

                $process = Start-Process `
                    -FilePath $python `
                    -ArgumentList @(
                        "manage.py",
                        "runserver",
                        "0.0.0.0:$port",
                        "--noreload"
                    ) `
                    -WorkingDirectory (Get-Location).Path `
                    -RedirectStandardOutput "django-$port.log" `
                    -RedirectStandardError "django-$port-error.log" `
                    -WindowStyle Hidden `
                    -PassThru

                $started = $false

                for ($i = 0; $i -lt 30; $i++) {
                    Start-Sleep -Seconds 1

                    $process.Refresh()

                    if ($process.HasExited) {
                        Get-Content "django-$port-error.log" -ErrorAction SilentlyContinue
                        throw "Django process exited"
                    }

                    if (Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue) {
                        $started = $true
                        break
                    }
                }

                if (-not $started) {
                    Get-Content "django-$port-error.log" -ErrorAction SilentlyContinue
                    throw "Django failed to start on port $port"
                }

                Write-Output "Django is running on port $port"
            '''
        }
    }
}