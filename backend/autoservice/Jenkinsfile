pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        PROJECT_DIR      = 'backend'
        PYTHONIOENCODING = 'utf-8'

        ENABLE_DOCKER = 'true'
        REGISTRY      = 'https://ghcr.io'
        IMAGE_NAME    = 'ghcr.io/timmytay/autoservice'
        REG_CREDS     = 'ghcr-creds'
    }

    stages {
        stage('Checkout') {
            steps {
                echo "✅ Код получен из ветки ${env.BRANCH_NAME}"
            }
        }

        stage('Setup Python') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'if not exist venv\\Scripts\\python.exe python -m venv venv'
                    echo '✅ Виртуальное окружение готово'
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python -m pip install --upgrade pip'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 -r autoservice\\requirements.txt'
                    bat 'venv\\Scripts\\activate && pip install --timeout 100 pytest pytest-django pytest-cov'
                    echo '✅ Зависимости установлены'
                }
            }
        }

        stage('Check Django & Migrations') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && python manage.py check'
                    bat 'venv\\Scripts\\activate && python manage.py makemigrations --check --dry-run'
                    bat 'venv\\Scripts\\activate && python manage.py migrate'
                    echo '✅ Миграции в порядке'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    bat 'venv\\Scripts\\activate && pytest --cov=autoservice --cov-report=term'
                    echo '✅ Все тесты успешно пройдены'
                }
            }
        }

        stage('Docker Build & Push') {
            when {
                allOf {
                    expression {
                        env.ENABLE_DOCKER == 'true'
                    }
                    anyOf {
                        branch 'main'
                        branch 'develop'
                        branch 'release/*'
                    }
                }
            }

            steps {
                script {
                    def tag

                    if (env.BRANCH_NAME == 'main') {
                        tag = "${env.BUILD_NUMBER}"
                    } else if (env.BRANCH_NAME == 'develop') {
                        tag = "dev-${env.BUILD_NUMBER}"
                    } else {
                        tag = "rc-${env.BUILD_NUMBER}"
                    }

                    def image = "${env.IMAGE_NAME}:${tag}"
                    def latest = "${env.IMAGE_NAME}:latest"
                    def isMain = env.BRANCH_NAME == 'main'

                    withCredentials([usernamePassword(
                        credentialsId: env.REG_CREDS,
                        usernameVariable: 'REG_USER',
                        passwordVariable: 'REG_PASS'
                    )]) {
                        bat """
                            docker build -t ${image} ${env.PROJECT_DIR} || exit /b 1
                        """

                        pwsh '''
                            $env:REG_PASS | docker login ghcr.io -u $env:REG_USER --password-stdin

                            if ($LASTEXITCODE -ne 0) {
                                exit $LASTEXITCODE
                            }
                        '''

                        try {
                            bat """
                                docker push ${image} || exit /b 1

                                if "${isMain}"=="true" (
                                    docker tag ${image} ${latest} || exit /b 1
                                    docker push ${latest} || exit /b 1
                                )
                            """
                        } finally {
                            bat 'docker logout ghcr.io'
                        }
                    }

                    echo "✅ Docker-образ опубликован: ${image}"
                }
            }
        }

        stage('Deploy (prod)') {
            when {
                branch 'main'
            }

            steps {
                script {
                    deployDjango(8000)
                }

                echo '✅ Production развёрнут на порту 8000'
            }
        }

        stage('Deploy (staging)') {
            when {
                anyOf {
                    branch 'develop'
                    branch 'release/*'
                }
            }

            steps {
                script {
                    deployDjango(8001)
                }

                echo '✅ Staging развёрнут на порту 8001'
            }
        }

        stage('Info') {
            steps {
                echo """
                    Ветка: ${env.BRANCH_NAME}
                    Номер сборки: ${env.BUILD_NUMBER}
                    Production: http://localhost:8000
                    Staging: http://localhost:8001
                """
            }
        }
    }

    post {
        success {
            echo '✅ Пайплайн успешно выполнен!'
        }

        failure {
            echo '❌ Ошибка в пайплайне! Проверьте логи этапа, на котором произошёл сбой.'
        }
    }
}

def deployDjango(int port) {
    dir("${env.PROJECT_DIR}") {
        withEnv([
            'JENKINS_NODE_COOKIE=dontKillMe',
            "DEPLOY_PORT=${port}"
        ]) {
            pwsh '''
                $port = [int]$env:DEPLOY_PORT

                $connections = Get-NetTCPConnection `
                    -LocalPort $port `
                    -State Listen `
                    -ErrorAction SilentlyContinue

                foreach ($connection in $connections) {
                    Stop-Process `
                        -Id $connection.OwningProcess `
                        -Force `
                        -ErrorAction SilentlyContinue
                }

                Start-Sleep -Seconds 2

                $python = Join-Path `
                    (Get-Location).Path `
                    "venv\\Scripts\\python.exe"

                Start-Process `
                    -FilePath $python `
                    -ArgumentList @(
                        "manage.py",
                        "runserver",
                        "0.0.0.0:$port",
                        "--noreload"
                    ) `
                    -WorkingDirectory (Get-Location).Path `
                    -RedirectStandardOutput "django-$port.log" `
                    -RedirectStandardError "django-$port-error.log" `
                    -WindowStyle Hidden

                Start-Sleep -Seconds 3

                if (-not (Get-NetTCPConnection `
                    -LocalPort $port `
                    -State Listen `
                    -ErrorAction SilentlyContinue)) {
                    throw "Django failed to start on port $port"
                }
            '''
        }
    }
}